# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용한다.
# 특수문자($, # 등)가 들어간 값은 작은따옴표로 감쌀 것

JWT_SECRET=change-me
HASH_ROUNDS=10

PROTOCOL=http
PORT=3100
HOST=localhost:3100

# Prisma 접속 문자열 (비밀번호는 퍼센트 인코딩)
# 예: ! -> %21
DATABASE_URL="postgresql://intranet_user:change-me@localhost:5433/intranet?schema=public"

# 업로드 파일 저장 루트 (로컬 저장소). 상대 경로는 backend(서버 실행 위치) 기준 → intranet/uploads, 비우면 같은 값
UPLOAD_ROOT=../uploads
