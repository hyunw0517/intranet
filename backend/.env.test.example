# e2e 테스트 전용 (npm run test:e2e). .env 대신 이 값이 먼저 들어간다.
# DB 이름이 _test로 끝나지 않으면 테스트가 시작 전에 멈춘다. (개발 DB TRUNCATE 방지)
JWT_SECRET=change-me
HASH_ROUNDS=4

PROTOCOL=http
PORT=3199
HOST=localhost:3199

DATABASE_URL="postgresql://intranet_test_user:change-me@localhost:5433/intranet_test?schema=public"

# 테스트 업로드 파일은 개발 업로드와 섞이지 않게 따로
UPLOAD_ROOT=../uploads-test
